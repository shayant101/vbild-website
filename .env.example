# ── Admin portal (/admin) ─────────────────────────────────────
# Required for the team login. Set these in Vercel → Project → Settings → Environment Variables.
ADMIN_EMAIL=team@vbild.ai
ADMIN_PASSWORD=change-me-before-deploy
# Any random string, 32+ chars. Generate: openssl rand -base64 32
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret-string

# ── Bildr voice intake (/start) and live demo mode (/demo) ────
ANTHROPIC_API_KEY=
NEXT_PUBLIC_DEEPGRAM_API_KEY=

# ── Contact form + Bildr sales handoff email ──────────────────
GMAIL_USER=
GMAIL_PASS=

# ── Analytics (optional) ──────────────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
