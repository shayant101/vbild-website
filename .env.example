# ── Admin portal (/admin) — passkeys + invite links ───────────
# No passwords. Sessions are signed with this secret (any random 32+ chars); members/passkeys live in SCAN_DATABASE_URL.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret-string

# ── Bildr voice intake (/start) and live demo mode (/demo) ────
ANTHROPIC_API_KEY=
NEXT_PUBLIC_DEEPGRAM_API_KEY=

# ── Contact form + Bildr sales handoff email ──────────────────
GMAIL_USER=
GMAIL_PASS=

# ── Analytics (optional) ──────────────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ── Vbild Scan (lead magnet) ──────────────────────────────────
# Google Cloud → enable "Places API (New)" + "PageSpeed Insights API"; restrict key to those two.
GOOGLE_PLACES_API_KEY=
# Dedicated Postgres role on the vbild-ops Supabase project (schema "scan" only). See HANDOFF-v2.md.
SCAN_DATABASE_URL=
# Where lead alerts go (email via GMAIL_* above; SMS optional via Twilio)
LEAD_NOTIFY_EMAIL=shayan.s.toor@gmail.com
LEAD_NOTIFY_PHONE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
